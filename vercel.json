{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "functions": {
    "api/automation/run.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    { "path": "/api/automation/run?batch=1", "schedule": "0 16 * * *" },
    { "path": "/api/automation/run?batch=2", "schedule": "0 17 * * *" },
    { "path": "/api/automation/run?batch=3", "schedule": "0 18 * * *" },
    { "path": "/api/automation/run?batch=4", "schedule": "0 19 * * *" },
    { "path": "/api/automation/run?batch=5", "schedule": "0 20 * * *" },
    { "path": "/api/automation/run?batch=6", "schedule": "0 21 * * *" },
    { "path": "/api/automation/run?batch=7", "schedule": "0 22 * * *" },
    { "path": "/api/automation/run?batch=8", "schedule": "0 23 * * *" },
    { "path": "/api/automation/run?batch=9", "schedule": "0 0 * * *" },
    { "path": "/api/automation/run?batch=10", "schedule": "0 1 * * *" },
    { "path": "/api/automation/run?batch=11", "schedule": "0 2 * * *" },
    { "path": "/api/automation/run?batch=12", "schedule": "0 3 * * *" }
  ]
}
