{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/automation/run.js": {
      "maxDuration": 300
    },
    "api/automation/dispatch.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/automation/dispatch",
      "schedule": "0 1 * * *"
    }
  ]
}
