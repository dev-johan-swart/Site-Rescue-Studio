{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/automation/run.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    { "path": "/api/automation/run?batch=1", "schedule": "0 1 * * *" },
    { "path": "/api/automation/run?batch=2", "schedule": "0 2 * * *" },
    { "path": "/api/automation/run?batch=3", "schedule": "0 3 * * *" },
    { "path": "/api/automation/run?batch=4", "schedule": "0 4 * * *" },
    { "path": "/api/automation/run?batch=5", "schedule": "0 5 * * *" }
  ]
}
